# ==============================================================
# TELE SKOR Yönetim Paneli — ortam değişkenleri
# ==============================================================

# Teleskor backend'i (api-1). Sunucuda compose.prod.yaml bunu iç ağ adresiyle
# (`http://app:8080`) veriyor; yalnız farklı bir adres gerekiyorsa
# TELESKOR_BACKEND_URL_IC ile değiştir. Yerelde:
TELESKOR_BACKEND_URL=http://localhost:8080

# Site Haritası ekranının inceleme araçları (dosya önizleme, adres denetimi,
# robots.txt) siteyi bu kökten arama motoru gibi okur. Varsayılan canlı site;
# yalnız yerel denemede değişir.
# TELESKOR_WEB_URL=https://www.teleskor.com.tr

# Giriş TELESKOR HESABIYLA (e-posta ya da kullanıcı adı); rolü ADMIN ya da
# SEO olan hesaplar girebilir (SEO yalnız Site Haritası ekranını görür).
# Yeni yönetici/danışman: Teleskor'da hesap aç, panelde Üyeler → rol. Hizmet hesabı (TELESKOR_ADMIN_USER/PASSWORD)
# 28 Eylül'de kalktı; sunucudaki .env'de duruyorsa silinebilir.

# ---- Erişim kapısı (isteğe bağlı: adresi bilen de önce anahtar girer) ----
# İKİSİ de doluysa panel (giriş dâhil) önce /gate'te bir anahtar ister;
# boşsa kapı TAMAMEN kapalıdır. Anahtar yalnız sunucuda doğrulanır.
#   PANEL_GATE_KEY  : yöneticilerin gireceği paylaşımlı anahtar.
#   PANEL_GATE_TOKEN: çereze yazılan opak değer (uzun rastgele, gizli).
#                     Üretmek için:  openssl rand -hex 32
# PANEL_GATE_KEY=
# PANEL_GATE_TOKEN=
